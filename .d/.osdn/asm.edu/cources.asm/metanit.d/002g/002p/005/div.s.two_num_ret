# Первая программа
#! not work
.globl _start
 
.section .text
_start:
    movq $22, %rax
    # extend %rdx nuls
    movq $0, %rdx 
    movq $5, %rcx
    # divq :: allways RAX first_div, RDX rem_frov_div
    # RAX = RAX / RCX :: RAX =4 (результат), RDX = 2 (остаток)
    divq %rcx
    movq %rax, %rdi   # RDI = RAX = 4
    movq $60, %rax
    syscall
    movq %rdx, %rdi   # RDI = RDX = 2
    movq $60, %rax
    syscall

    
